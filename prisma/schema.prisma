generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Submission {
  id           String   @id @default(cuid())
  fullName     String
  registration String   @unique
  q1           String
  q2           String
  q3           String
  q4           String
  score        Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([registration])
  @@index([createdAt])
}